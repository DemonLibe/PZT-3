[gd_resource type="Resource" script_class="AnomalyData" format=3]

[ext_resource type="Script" path="res://anomalies/base/anomaly_data.gd" id="1_data"]

[resource]
script = ExtResource("1_data")
id = &"voices"
display_name = "Голоса в рации"
location = "Район 24"
danger_level = 4
params = {
"call_interval": 20.0,
"panic_call": 0.06
}
guide_hint = "В рации будут свои. Бывшие свои. Не отвечать — бесполезно."
encyclopedia_text = "Классификация: акустическая / информационная. Опасность: высокая.
Радиостанции группы начинают принимать голоса, опознанные как принадлежащие погибшим или пропавшим участникам прошлых экспедиций.
---
Голоса зовут на помощь, называют текущие координаты группы точно, будто наблюдают со стороны. Ответ по рации на эти голоса не запрещён формально, но ни разу не приводил ни к чему, кроме повторного вызова с тем же текстом с разницей в интонации."
