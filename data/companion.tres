[resource]
script = ExtResource("1_data")
id = &"companion"
display_name = "Спутник за столом"
location = "Район 27"
danger_level = 5
params = {

}
punishment = SubResource("Resource_punishment")
guide_hint = "Кто сидит за столом — не окликать. Ни слова. Обходим молча."
encyclopedia_text = "Классификация: активная, отличается от Района 1. Опасность: критическая.
В отдельных домах на накрытом столе (см. Район 1) уже сидит фигура, всегда спиной к входу. Фигура не двигается и не оборачивается.
---
Фигура не двигается — до тех пор, пока к ней не обратятся по имени или не окликнут любым способом. Что происходит при обращении, не задокументировано: единственная группа, попытавшаяся это сделать, не вышла на связь."
