[resource]
script = ExtResource("1_data")
id = &"dinner"
display_name = "Ужин"
location = "Район 1"
danger_level = 3
params = {
"drowsiness_relief": 0.4,
"eat_duration": 3.0,
"onset_max_hours": 9.0,
"onset_min_hours": 3.0
}
punishment = SubResource("Resource_punishment")
guide_hint = "Со стола ничего не брать. Даже если пахнет как дома."
encyclopedia_text = "Классификация: активная / поведенческая. Опасность: средняя (высокая скрытая летальность).
Во всех домах накрыт стол — горячая пища, посуда без пыли. Химический анализ безопасен, состав обычный. В одной из записей стол был накрыт на 10 персон при составе группы в 9 человек. Десятое место убрано не было.
---
Приём пищи строго запрещён. По журналам 6 групп установлена 100%-я корреляция между употреблением пищи и последующей (3–9 дней) амнезией цели и отказом покидать дом."
