[ext_resource type="Script" path="res://anomalies/base/anomaly_data.gd" id="1_data"]

[resource]
script = ExtResource("1_data")
id = &"door"
display_name = "Дверь"
location = "Район 21"
danger_level = 4
params = {
"base_gap_deg": 3.0,
"growth_deg": 4.0,
"panic_look": 0.05
}
guide_hint = "Ту дверь не трогать и в щель не заглядывать. Закроете — в следующий раз будет шире."
encyclopedia_text = "Классификация: пространственная. Опасность: высокая.
В одном из домов — дверь, всегда приоткрытая на несколько сантиметров, за ней темнота, свет фонаря её не пробивает.
---
Если дверь закрыть, к следующему обходу она снова приоткрыта, и щель шире прежней на несколько сантиметров. Измерения по журналам за 8 месяцев: щель увеличивается линейно. Расчётная дата, когда дверь будет открыта полностью, — предмет отдельного секретного протокола."
