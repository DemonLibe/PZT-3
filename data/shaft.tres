[gd_resource type="Resource" script_class="AnomalyData" format=3]

[ext_resource type="Script" path="res://anomalies/base/anomaly_data.gd" id="1_data"]

[resource]
script = ExtResource("1_data")
id = &"shaft"
display_name = "Смотрящий из шахты"
location = "Секция 49"
danger_level = 4
params = {
"faint_time": 12.0,
"gap_max_hours": 24.0,
"gap_min_hours": 2.0,
"stare_limit": 1.0
}
encyclopedia_text = "Тип: сущность, обитающая в вертикальных полостях. Опасность: высокая.
В открытых лифтовых и вентиляционных шахтах секции при направленном взгляде вниз можно различить нечто похожее на глаз, значительно превышающий человеческий по масштабу относительно расстояния.
---
Правило: не заглядывать в открытые вертикальные шахты дольше секунды, обходить их по максимально широкой дуге. Наказание: в 2 случаях наблюдатель, задержавший взгляд, терял сознание на месте; придя в себя, участники сообщали о провалах в памяти длительностью от нескольких часов до суток."
