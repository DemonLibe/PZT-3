[gd_resource type="Resource" script_class="AnomalyData" format=3]

[ext_resource type="Script" path="res://anomalies/base/anomaly_data.gd" id="1_data"]

[resource]
script = ExtResource("1_data")
id = &"keymaster"
display_name = "Хозяин ключей"
location = "Секция 40"
danger_level = 5
params = {
"offer_time": 10.0
}
encyclopedia_text = "Тип: сущность, вступающая в переговоры. Опасность: критическая, обманчива.
Единственная сущность в Гигадоме, вступающая в прямой диалог. Предлагает ключ, открывающий любую запертую дверь секции, в обмен на нечто нематериальное — имя, воспоминание, палец (формулировка каждый раз иная).
---
Правило: категорический запрет на любой обмен с сущностью независимо от формулировки предложения. Наказание: взявший ключ теряет то, что отдал, немедленно и необратимо; ключ при этом либо не подходит ни к одной двери, либо открывает дверь, за которой ничего полезного не найдено. Оценивается комиссией как чистый обман."
