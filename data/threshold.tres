[resource]
script = ExtResource("1_data")
id = &"threshold"
display_name = "Порог"
location = "Секция 30"
danger_level = 1
params = {

}
encyclopedia_text = "Тип: переходная, не заселена. Опасность: отсутствует.
Последний район старой структуры. Полностью безопасен по всем 40+ обходам.
---
Единственная секция, где ни разу не зафиксировано ни одной аномалии любого типа. Служит точкой перехода в Гигадом — стены здесь без видимого шва переходят из жилой застройки в бетонный коридор неизвестной архитектуры."
