[resource]
script = ExtResource("1_data")
id = &"reflection"
display_name = "Отражение группы"
location = "Район 12"
danger_level = 5
params = {
"approach_limit": 15.0,
"delay_max": 40.0,
"delay_min": 3.0,
"omen_delay": 60.0
}
punishment = SubResource("Resource_punishment")
guide_hint = "Видите вторую группу — не подходить, фонарём не светить. Делаем своё и уходим."
encyclopedia_text = "Классификация: дублирующая. Опасность: критическая.
На расстоянии 200–400 м периодически видна вторая группа, идентичная составу и маршруту наблюдающей, с задержкой движения 3–40 секунд, нестабильной и не коррелирующей с расстоянием. В отличие от Района 7, попыток коммуникации «отражение» не предпринимает никогда.
---
В 3 случаях задержка была отрицательной — «отражение» опережало действия оригинальной группы на несколько минут. В обоих случаях в течение часа с оригинальной группой происходило событие, идентичное замеченному у «отражения».
Не приближаться. Не подавать сигналов."
