[gd_resource type="Resource" script_class="AnomalyData" format=3]

[ext_resource type="Script" path="res://anomalies/base/anomaly_data.gd" id="1_data"]
[ext_resource type="Script" path="res://anomalies/base/punishment.gd" id="2_punishment"]

[sub_resource type="Resource" id="Resource_punishment"]
script = ExtResource("2_punishment")
type = 2
status_id = &"smile_fixed"

[resource]
script = ExtResource("1_data")
id = &"smile"
display_name = "Улыбка"
location = "Район 9"
danger_level = 4
params = {
"direct_cone_deg": 12.0,
"fix_max_hours": 5.0,
"fix_min_hours": 3.0,
"react_time": 2.5,
"see_distance": 14.0
}
punishment = SubResource("Resource_punishment")
guide_hint = "Лицо держать каменным. На фотографии и в окна не засматриваться."
encyclopedia_text = "Классификация: поведенческая / мышечная. Опасность: высокая, необратимая.
На фотографиях, в отражениях и у редких силуэтов в домах — одно выражение лица: улыбка, растянутая сильнее анатомической нормы.
---
Если участник улыбнётся в ответ (даже рефлекторно), лицевые мышцы теряют способность расслабляться. Сутки — лёгкая скованность. Трое суток — улыбка фиксируется постоянно, включая сон. На пятые сутки в одном случае — перелом челюсти от неконтролируемого сокращения мышц.
Полный запрет на любые мимические реакции при входе в район."
