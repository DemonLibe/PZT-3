[resource]
script = ExtResource("1_data")
id = &"cradle"
display_name = "Колыбель"
location = "Секция 32"
danger_level = 5
params = {
"attack_range": 1.5,
"forget_after": 8.0,
"hearing_radius": 25.0,
"min_noise": 0.15,
"rush_distance": 8.0,
"rush_speed": 6.0,
"walk_speed": 1.5
}
punishment = SubResource("Resource_punishment")
encyclopedia_text = "Тип: существо, стационарно-подвижное. Опасность: экстремальная, провоцируется звуком.
В секции обитает высокое человекоподобное существо с непропорционально длинными пальцами и красными глазами. Слепо, ориентируется исключительно на звук извне — на звук, источник которого не является самим существом.
---
Правило: полная тишина. Существо не тронет спящего или принимающего пищу человека — неподвижное, тихое состояние безопасно. Наказание: нарушитель тишины разрывается на части и поедается существом на месте.
Это единственная известная секция, где сон не запрещён, а рекомендован как способ выживания — прямая противоположность Району 8."
