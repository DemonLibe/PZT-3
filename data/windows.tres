[resource]
script = ExtResource("1_data")
id = &"windows"
display_name = "Окна"
location = "Район 2"
danger_level = 1
params = {
"cone_deg": 25.0,
"delay_max": 1.0,
"delay_min": 0.5,
"panic_add": 0.05,
