[ext_resource type="Script" path="res://anomalies/base/punishment.gd" id="2_punishment"]

[sub_resource type="Resource" id="Resource_punishment"]
script = ExtResource("2_punishment")
type = 1

[resource]
script = ExtResource("1_data")
id = &"mirror"
display_name = "Зеркало"
location = "Район 5"
danger_level = 4
params = {
"direct_cone_deg": 10.0,
"flash_multiplier": 3.0,
"mimic_delay": 0.5,
"reset_after": 1.0,
"safe_time": 4.0,
"vanish_time": 15.0
}
punishment = SubResource("Resource_punishment")
guide_hint = "В окна не пялиться. Четыре секунды — край. Идём, смотрим краем глаза."
encyclopedia_text = "Классификация: визуальная / когнитивная. Опасность: высокая при нарушении протокола.
Во всех окнах района — одно и то же статичное изображение самого района, снятое будто с одной фиксированной точки, независимо от реального расположения окна.
---
Безопасно при взгляде до 4 секунд. Свыше — изображение начинает двигаться с задержкой относительно наблюдателя. Свыше 15 секунд — во всех случаях наблюдатель пропадал на месте без следов; стекло изнутри дома расколото, снаружи целое.
Движение по району — только периферийным зрением. Окна не фотографировать: вспышка увеличивает время «контакта» камеры."
