[resource]
script = ExtResource("1_data")
id = &"sleep"
display_name = "Сон"
location = "Район 8"
danger_level = 4
params = {
"death_max": 40.0,
"death_min": 20.0,
"drowsiness_rate": 0.01,
"wake_drowsiness": 0.5,
"wake_taps": 8,
"watch_limit_minutes": 40
}
punishment = SubResource("Resource_punishment")
guide_hint = "Не спать. Кто клюёт носом — будить сразу. Услышите, что кто-то считает, — трясите соседа."
encyclopedia_text = "Классификация: физиологическая / принудительная. Опасность: экстремальная.
На входе — резкая, некупируемая стимуляторами сонливость. Причина не установлена.
---
СТРОГИЙ ЗАПРЕТ НА СОН. При засыпании (4 случая) глазные яблоки спящего разрываются изнутри за 20–40 секунд от начала фазы сна. Смерть мгновенная. Все выжившие свидетели сообщают об одинаковом звуке перед разрывом — тихий, ритмичный, «будто кто-то считает».
Обход разрешён только со сменным дежурством бодрствования, максимум 40 минут на человека."
