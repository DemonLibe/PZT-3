[ext_resource type="Script" path="res://anomalies/base/anomaly_data.gd" id="1_data"]

[resource]
script = ExtResource("1_data")
id = &"ceiling"
display_name = "Потолок"
location = "Район 25"
danger_level = 3
params = {
"hallucination_time": 90.0,
"inhale_time": 25.0
}
guide_hint = "В квартиры с пятнами на потолке надолго не заходить. Дышать через рукав."
encyclopedia_text = "Классификация: биологическая / химическая. Опасность: средняя.
В отдельных домах на потолках проступают тёмные пятна, по консистенции похожие на кровь, медленно капающие.
---
Лабораторный анализ вещества не идентифицирует его ни с одним известным биоматериалом. При вдыхании паров вещества (1 подтверждённый случай) — стойкие зрительные галлюцинации на протяжении нескольких часов, содержание которых пострадавший впоследствии отказался описывать."
