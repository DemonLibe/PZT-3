[gd_resource type="Resource" script_class="AnomalyData" format=3]

[ext_resource type="Script" path="res://anomalies/base/anomaly_data.gd" id="1_data"]

[resource]
script = ExtResource("1_data")
id = &"mail"
display_name = "Почта"
location = "Район 14"
danger_level = 4
params = {
"panic_read": 0.45
}
guide_hint = "Ящики не открывать. Что бы там ни было написано — не про вас."
encyclopedia_text = "Классификация: информационная / личная. Опасность: высокая (психологическая).
В почтовых ящиках — письма, адресованные лично каждому участнику по имени.
---
Письма содержат детали биографии, которые не значатся ни в одном личном деле и не могли быть известны зоне. Содержание писем не разглашается участниками добровольно — все опрошенные отказывались пересказывать текст, при этом демонстрировали выраженную тревожную реакцию на упоминание имени отправителя."
