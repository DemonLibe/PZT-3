[resource]
script = ExtResource("1_data")
id = &"kitchen"
display_name = "Кухня"
location = "Район 10"
danger_level = 5
params = {
"drowsiness_relief": 0.3,
"eat_duration": 3.0
}
guide_hint = "Холодильники не открывать. Что бы там комиссия ни писала."
encyclopedia_text = "Классификация: биологическая / неопределённая. Опасность: экстремальная.
В холодильниках — свежее мясо, по виду, запаху и вкусу неотличимое от обычного, лабораторно подтверждено как животное (свинина, говядина). Употребление ранее считалось безопасным.
---
На 19-м обходе повторный, более глубокий анализ одного образца показал структуру мышечной ткани, характерную для человека, при формальном результате ДНК-теста «свинья». Тест повторён трижды. Результат не изменился.
Комиссия рекомендует считать мясо животным до дальнейших указаний. Рекомендация не отражает уверенности комиссии, а является политическим решением."
