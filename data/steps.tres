[gd_resource type="Resource" script_class="AnomalyData" format=3]

[ext_resource type="Script" path="res://anomalies/base/anomaly_data.gd" id="1_data"]
[ext_resource type="Script" path="res://anomalies/base/punishment.gd" id="2_punishment"]

[sub_resource type="Resource" id="Resource_punishment"]
script = ExtResource("2_punishment")
type = 1

[resource]
script = ExtResource("1_data")
id = &"steps"
display_name = "Шаги"
location = "Район 20"
danger_level = 2
params = {
"doom_delay": 3.0,
"min_walk_before_stop": 2.0,
"step_after_stop_chance": 0.08
}
punishment = SubResource("Resource_punishment")
guide_hint = "Замыкающий — не останавливаться. Идём ровно, без рывков."
encyclopedia_text = "Классификация: акустическая. Опасность: низкая до провокации, далее не установлена.
Позади группы слышны шаги, в точности повторяющие шаги замыкающего, с задержкой ровно в один шаг.
---
Единственный зафиксированный протокол: если замыкающий останавливается, а шаг позади всё равно раздаётся — дальнейшие записи по 2 из 2 таких случаев отсутствуют."
