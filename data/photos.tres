[gd_resource type="Resource" script_class="AnomalyData" format=3]

[ext_resource type="Script" path="res://anomalies/base/anomaly_data.gd" id="1_data"]

[resource]
script = ExtResource("1_data")
id = &"photos"
display_name = "Фотографии"
location = "Район 18"
danger_level = 3
params = {
"panic_self": 0.25
}
guide_hint = "На фотографии не смотреть. Узнаете кого — молчите."
encyclopedia_text = "Классификация: визуальная, накопительная. Опасность: средняя, растёт со временем пребывания группы в зоне.
На стенах домов — семейные фотографии.
---
При повторных обходах одного и того же дома лица на снимках медленно, за недели, меняются — на лица действующего состава группы, в том же порядке, в каком они входили в дом. Свежепоступившие группы фотографий с собой не узнают. Группы с длительным стажем в зоне узнают себя на старых снимках и не могут объяснить, когда фотографировались."
