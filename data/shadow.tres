[gd_resource type="Resource" script_class="AnomalyData" format=3]

[ext_resource type="Script" path="res://anomalies/base/anomaly_data.gd" id="1_data"]
[ext_resource type="Script" path="res://anomalies/base/punishment.gd" id="2_punishment"]

[sub_resource type="Resource" id="Resource_punishment"]
script = ExtResource("2_punishment")
type = 1

[resource]
script = ExtResource("1_data")
id = &"shadow"
display_name = "Тень"
location = "Район 6"
danger_level = 5
params = {
"check_interval": 5.0,
"journal_cut": true,
"point_chance": 0.15,
"point_duration": 6.0,
"turn_deg": 150.0,
"turn_window": 1.0
}
punishment = SubResource("Resource_punishment")
guide_hint = "Тень куда-то показывает — не оборачиваться. Ни на что."
encyclopedia_text = "Классификация: визуальная / автономная. Опасность: средняя, эскалирует при провокации.
Собственная тень при определённом освещении перестаёт повторять движения — задерживается, затем указывает рукой в сторону, разворачивается к чему-то за спиной наблюдателя.
---
Прямого вреда не зафиксировано. Опасность — в реакции: во всех 5 случаях участник, чья тень указывала, оборачивался посмотреть. Все 5 отчётов обрываются на этом месте одинаково, будто вырваны."
